# Copy to .env and fill in as needed. Never commit .env.
#
# Ingestion, retrieval, and evaluation run fully offline with local models and need
# nothing here. Only `ask` requires a key.

# --- Grounded answer generation (required by `python -m rag_eval ask`) ---
# ANTHROPIC_API_KEY=

# --- Local model cache locations (optional) ---
# HF_HOME=./.cache/huggingface
# SENTENCE_TRANSFORMERS_HOME=./.cache/sentence-transformers
